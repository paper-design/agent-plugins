{
  "name": "agent-plugins",
  "type": "module",
  "private": true,
  "keywords": ["pi-package"],
  "scripts": {
    "audit:production": "npm audit --omit=dev --audit-level=moderate",
    "build": "bun ./scripts/validate-cursor-schema.mjs && bun ./scripts/validate-cursor-structure.mjs && bun ./scripts/validate-codex.mjs && bun run validate:pi",
    "validate:pi": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck plugins/paper-desktop/pi/index.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@types/bun": "latest",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "typebox": "^1.1.38",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "pi": {
    "extensions": ["./plugins/paper-desktop/pi"],
    "skills": ["./plugins/paper-desktop/skills"]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "fast-uri": "3.1.4"
  }
}
